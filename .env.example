# /scsrun/app/maze-in-dungeon/.env  (git 에 올리지 않음) — 포트·경로는 scsrun.conf 에서 설정
SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=https://maze.duruwap.com   # 비우면 요청 주소로 자동 판별 (반드시 외부에서 열리는 https 주소)
KAKAO_JS_KEY=
# 선택: 결과 카드 중국어 간체 대체 글꼴 (없으면 시스템 Noto CJK → WenQuanYi)
# FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc
# 선택: Kakao SDK 버전/무결성 해시 교체
# KAKAO_SDK_URL=https://t1.kakaocdn.net/kakao_js_sdk/2.7.4/kakao.min.js
# KAKAO_SDK_INTEGRITY=sha384-...
